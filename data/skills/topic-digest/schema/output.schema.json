{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pentou://skills/topic-digest/output",
  "title": "topic-digest output",
  "type": "object",
  "properties": {
    "docId": { "type": "string", "description": "汇总文档 id" },
    "folderId": { "type": "string", "description": "所在 AI 空间的文件夹 id" },
    "topic": { "type": "string" },
    "sourceCount": { "type": "integer", "description": "汇总所依据的片段数" },
    "citations": {
      "type": "array",
      "description": "汇总所引用的来源",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["conversation", "document"] },
          "id": { "type": "string" },
          "title": { "type": "string" }
        },
        "required": ["type", "id", "title"],
        "additionalProperties": false
      }
    }
  },
  "required": ["docId", "folderId", "topic", "sourceCount", "citations"],
  "additionalProperties": false
}
