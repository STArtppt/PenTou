{
  "name": "pentou",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Local-first AI conversation manager — pin, organize, and excerpt chats from ChatGPT / DeepSeek / Claude into native Markdown.",
  "license": "MIT",
  "author": "STArtppt",
  "homepage": "https://github.com/STArtppt/PenTou",
  "repository": {
    "type": "git",
    "url": "https://github.com/STArtppt/PenTou.git"
  },
  "bugs": {
    "url": "https://github.com/STArtppt/PenTou/issues"
  },
  "keywords": [
    "ai",
    "chatgpt",
    "deepseek",
    "claude",
    "conversation",
    "markdown",
    "local-first",
    "react",
    "vite"
  ],
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:all": "pnpm build && pnpm build:server",
    "start": "node dist-server/src/server/index.js",
    "dev": "vite",
    "postinstall": "node scripts/download-obscura.cjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "12.10.0",
    "cheerio": "^1.2.0",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "fflate": "^0.8.3",
    "formidable": "^3.5.1",
    "lucide-react": "0.487.0",
    "mermaid": "^11.15.0",
    "motion": "12.23.24",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "sonner": "2.0.3",
    "tw-animate-css": "1.3.8",
    "unified": "11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/better-sqlite3": "^7.6.13",
    "@types/formidable": "^3.4.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "^29.1.1",
    "node-gyp": "^12.4.0",
    "tailwindcss": "4.1.12",
    "typescript": "^6.0.3",
    "vite": "6.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
